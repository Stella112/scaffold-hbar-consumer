{
  "name": "scaffold-hbar-consumer",
  "description": "Programmable ConsumerAccounts on Hedera: sponsored (zero-HBAR) execution, signed payment requests, SaucerSwap swap-to-pay, HIP-904 delivery, policy-constrained agent sessions and HCS audit.",
  "version": "0.1.0",
  "create-scaffold-hbar": {
    "requirements": {
      "node": ">=20.18.3"
    },
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"],
      "packageManager": ["yarn"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "yarn"
    },
    "outro": {
      "sections": [
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Add a funded ECDSA testnet operator to .env",
              "command": "cp .env.example .env"
            },
            {
              "label": "Get a testnet account and HBAR",
              "url": "https://portal.hedera.com"
            },
            {
              "label": "Check your setup against live testnet",
              "command": "{run:doctor}"
            },
            {
              "label": "Plan, then create sponsor accounts, deploy the factory and the HCS audit topic",
              "command": "{run:bootstrap} --fund"
            },
            {
              "label": "Start the app",
              "command": "{run:start}"
            },
            {
              "label": "Reproduce the testnet proofs",
              "command": "{run:prove:testnet}"
            }
          ]
        }
      ]
    }
  }
}
