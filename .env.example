# Copy to .env (gitignored). Every variable here is server-side only unless it starts with NEXT_PUBLIC_.
# Never commit .env, never paste keys into issues, chat or source.

# --- Required: one funded ECDSA testnet account with an EVM alias (portal.hedera.com) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
# 32-byte ECDSA private key hex (with or without 0x). Deploys contracts and funds role accounts (only with --fund).
HEDERA_OPERATOR_KEY=

# --- Written by `yarn bootstrap` (keys are generated locally; accounts are created only with --fund) ---
# Sponsor: pays sponsored transaction fees and HCS audit messages. Never owns user assets.
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# Controller: the human user's signing key. Has no Hedera account and 0 HBAR by design.
CONTROLLER_PRIVATE_KEY=
# Agent session key: signs typed actions only; also needs no HBAR.
AGENT_PRIVATE_KEY=
# Demo merchant (associated with demo tokens) and an intentionally unassociated HIP-904 recipient.
MERCHANT_ACCOUNT_ID=
MERCHANT_PRIVATE_KEY=
UNASSOCIATED_ACCOUNT_ID=
UNASSOCIATED_PRIVATE_KEY=
# HCS topic for policy audit records (submit key = sponsor key).
HCS_AUDIT_TOPIC_ID=

# --- Optional overrides (defaults verified in docs/SOURCES.md) ---
HEDERA_RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
# Sponsor policy (protects sponsor HBAR; user funds are protected on-chain).
SPONSOR_DAILY_BUDGET_HBAR=50
SPONSOR_PER_USER_DAILY_HBAR=10
SPONSOR_RATE_LIMIT_PER_MINUTE=20
# IPriceOracle for new accounts. Empty = bootstrap deploys SupraPriceOracle over Supra's testnet push feeds.
# Any oracle that is stale or unavailable makes session spend fail closed with PRICE_UNAVAILABLE.
PRICE_ORACLE=
RELAYER_PORT=4010
RELAYER_DATA_DIR=.data/relayer
# Deployed app used by prove:testnet flow 7 (MCP agent) and by the MCP server (packages/mcp).
CONSUMER_APP_URL=http://localhost:3000

# --- Frontend (public) ---
NEXT_PUBLIC_CHAIN_ID=296
NEXT_PUBLIC_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Demo faucet (testnet): one-time HBAR from the sponsor to new accounts so visitors can try every feature.
FAUCET_HBAR=25
FAUCET_DAILY_HBAR=300
FAUCET_SPONSOR_RESERVE_HBAR=40
